ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the knowledge-base directory
# ALETHEIA_KB_DIR=./knowledge-base

# Optional: override the config file
# ALETHEIA_CONFIG=./config/thresholds.json

# ─── MCP corpus sources ────────────────────────────────────────────
# Configure any of the below to make that source selectable via
# --source mcp:<name> on the CLI or the source dropdown in the web UI.
# The interactive `pnpm aletheia connect <name>` command guides you
# through obtaining and installing each token.

# Notion — get a token from https://www.notion.so/my-integrations
# ALETHEIA_NOTION_TOKEN=secret_your-token-here

# Optional: override the Notion MCP server command (default: npx -y @notionhq/notion-mcp-server)
# ALETHEIA_NOTION_MCP_COMMAND=npx
# ALETHEIA_NOTION_MCP_ARGS=-y @notionhq/notion-mcp-server
