{
  "name": "aletheia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A verifiable knowledge-base explorer. Every claim in every answer traces back to a specific quote in a specific document, with fuzzy-match verification that the quote is real.",
  "keywords": [
    "rag",
    "verifiable",
    "knowledge-base",
    "citations",
    "anthropic",
    "claude",
    "agent",
    "llm",
    "nextjs"
  ],
  "author": {
    "name": "Nima Edelkhani"
  },
  "license": "MIT",
  "homepage": "https://github.com/Nima-Edelkhani/agent-aletheia#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nima-Edelkhani/agent-aletheia.git"
  },
  "bugs": {
    "url": "https://github.com/Nima-Edelkhani/agent-aletheia/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/setup.mjs",
    "kill": "node scripts/kill.mjs",
    "serve": "next start",
    "aletheia": "tsx src/bin/aletheia.ts",
    "evals": "tsx evals/run-evals.ts",
    "evals:smoke": "tsx evals/run-evals.ts --smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.40.0",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-hover-card": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.10",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.9.3",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "motion": "^12.42.2",
    "nanoid": "^5.1.16",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
